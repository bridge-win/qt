# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS wheelhouse
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /download
COPY requirements-btc-monitor.lock ./
RUN python -m pip download \
    --require-hashes \
    --only-binary=:all: \
    --dest /wheelhouse \
    --requirement requirements-btc-monitor.lock

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    QT_BTC_MONITOR_STATE_DIR=/state \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore
COPY --from=wheelhouse /wheelhouse /wheelhouse
COPY requirements-btc-monitor.lock /tmp/requirements-btc-monitor.lock
RUN --network=none python -m pip install \
    --no-index \
    --no-compile \
    --require-hashes \
    --find-links=/wheelhouse \
    --requirement /tmp/requirements-btc-monitor.lock \
    && python -c "import shutil; shutil.rmtree('/wheelhouse')" \
    && rm /tmp/requirements-btc-monitor.lock \
    && printf 'qt:x:10001:\n' >> /etc/group \
    && printf 'qt:x:10001:10001:QT public-data monitor:/nonexistent:/bin/false\n' >> /etc/passwd \
    && mkdir /state \
    && chown 10001:10001 /state
WORKDIR /app
# Deliberately exclude execution, broker, account, API, and research packages.
COPY src/qt/__init__.py ./src/qt/__init__.py
COPY src/qt/btc_monitor ./src/qt/btc_monitor
USER 10001:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["python", "-m", "qt.btc_monitor"]
CMD ["run", "--state-dir", "/state"]
