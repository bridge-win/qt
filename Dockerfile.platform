# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS wheelhouse

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /download

COPY requirements-platform.lock ./
RUN python -m pip download \
    --require-hashes \
    --only-binary=:all: \
    --dest /wheelhouse \
    --requirement requirements-platform.lock


FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_NO_INDEX=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /build

COPY --from=wheelhouse /wheelhouse /wheelhouse
RUN --network=none python -m pip install \
    --no-cache-dir \
    --no-index \
    --find-links=/wheelhouse \
    setuptools==82.0.1 \
    wheel==0.47.0

COPY packages/btc-backtest ./packages/btc-backtest
RUN --network=none python -m pip wheel \
    --no-build-isolation \
    --no-deps \
    --no-index \
    --find-links=/wheelhouse \
    --wheel-dir=/wheelhouse \
    ./packages/btc-backtest \
    && test -f /wheelhouse/btc_backtest-0.1.0-py3-none-any.whl

COPY pyproject.toml README.md ./
COPY src ./src
RUN --network=none python -m pip wheel \
    --no-build-isolation \
    --no-deps \
    --no-index \
    --find-links=/wheelhouse \
    --wheel-dir=/wheelhouse \
    .


FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore

RUN --network=none printf 'qt:x:10001:\n' >> /etc/group \
    && printf 'qt:x:10001:10001:QT platform:/nonexistent:/bin/false\n' >> /etc/passwd

COPY --from=builder /wheelhouse /wheelhouse
RUN --network=none python -m pip install \
    --no-cache-dir \
    --no-compile \
    --no-index \
    --find-links=/wheelhouse \
    btc-backtest==0.1.0 \
    qt==0.1.0 \
    && test -f /wheelhouse/qt-0.1.0-py3-none-any.whl \
    && python -c "import shutil; shutil.rmtree('/wheelhouse')"

WORKDIR /app
COPY alembic.ini ./
COPY migrations ./migrations
COPY scripts/run_platform_api.py scripts/run_trading_worker.py ./scripts/
COPY --chmod=0555 deploy/platform-entrypoint.sh /usr/local/bin/platform-entrypoint

USER qt
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/platform-entrypoint"]
CMD ["api", "--host", "0.0.0.0", "--port", "8876"]
