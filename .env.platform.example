# Copy this file to .env.platform and replace every __GENERATE_ME__ token.
# Generate one URL-safe cryptographic password without printing it to logs:
# python -c "from pathlib import Path; import secrets; p=secrets.token_urlsafe(48); s=Path('.env.platform.example').read_text(); Path('.env.platform').write_text(s.replace('__GENERATE_ME__', p))"
# Keep POSTGRES_PASSWORD and the password segment of QT_DATABASE_URL identical.
# Validate safely before starting: docker compose --env-file .env.platform -f docker-compose.platform.yml config --quiet

QT_PLATFORM_ENV=production
QT_DATABASE_ECHO=false
QT_COMMAND_LEASE_SECONDS=30
QT_WORKER_STALE_SECONDS=60

POSTGRES_DB=qt_platform
POSTGRES_USER=qt_platform
POSTGRES_PASSWORD=__GENERATE_ME__
QT_DATABASE_URL=postgresql+psycopg://qt_platform:__GENERATE_ME__@postgres:5432/qt_platform

QT_TRADING_WORKER_ID=trading-1
QT_TRADING_WORKER_POLL_SECONDS=1
QT_PLATFORM_API_BIND=127.0.0.1
QT_PLATFORM_API_PORT=8876
QT_PLATFORM_IMAGE_TAG=local
