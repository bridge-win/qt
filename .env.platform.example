# Create a new mode-0600 environment file using secrets.token_urlsafe(48)
# without printing its password:
# python deploy/create_platform_env.py create --environment staging --image-reference qt-platform:local
# Production requires a registry-qualified name@sha256:<64 lowercase hex> reference.
# The helper rejects malformed references, env syntax, and duplicate assignments.
# Keep POSTGRES_PASSWORD and the password segment of QT_DATABASE_URL identical.
# Validate local development safely before starting:
# docker compose --env-file .env.platform -f docker-compose.platform.yml -f docker-compose.platform.local.yml config --quiet

QT_PLATFORM_ENV=staging
QT_DATABASE_ECHO=false
QT_COMMAND_LEASE_SECONDS=30
QT_WORKER_STALE_SECONDS=60

POSTGRES_DB=qt_platform
POSTGRES_USER=qt_platform
POSTGRES_PASSWORD=__GENERATE_ME__
QT_DATABASE_URL=postgresql+psycopg://qt_platform:__GENERATE_ME__@postgres:5432/qt_platform

QT_TRADING_WORKER_ID=trading-1
QT_TRADING_WORKER_POLL_SECONDS=1
QT_PLATFORM_API_BIND=127.0.0.1
QT_PLATFORM_API_PORT=8876
QT_PLATFORM_IMAGE=qt-platform:local
