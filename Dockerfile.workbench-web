# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM caddy:2.11.7-alpine
# Caddy listens on unprivileged 8080; remove the official image's file cap so
# nonroot execution also works with cap_drop:ALL and no-new-privileges.
RUN setcap -r /usr/bin/caddy \
    && addgroup -g 10001 qt && adduser -D -H -u 10001 -G qt qt
COPY --from=web /web/dist /srv
COPY deploy/orbstack.Caddyfile /etc/caddy/Caddyfile
USER 10001:10001
EXPOSE 8080
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
