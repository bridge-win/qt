# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS codex
ARG CODEX_VERSION=0.162.1
RUN npm install --global --registry=https://registry.npmjs.org @openai/codex@${CODEX_VERSION}

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS wheelhouse
WORKDIR /download
COPY requirements-btc-monitor.lock ./
RUN python -m pip download --require-hashes --only-binary=:all: --dest /wheelhouse --requirement requirements-btc-monitor.lock

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
COPY --from=wheelhouse /wheelhouse /wheelhouse
COPY requirements-btc-monitor.lock /tmp/requirements.lock
RUN --network=none python -m pip install --no-index --no-compile --require-hashes --find-links=/wheelhouse --requirement /tmp/requirements.lock \
    && rm -rf /wheelhouse /tmp/requirements.lock \
    && useradd --uid 10001 --no-create-home --home-dir /nonexistent qt \
    && mkdir /state && chown 10001:10001 /state
WORKDIR /app
COPY src/qt/__init__.py ./src/qt/__init__.py
COPY src/qt/btc_alerts ./src/qt/btc_alerts
USER 10001:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["python", "-m", "qt.btc_alerts"]
CMD ["run"]

FROM runtime AS reviewer
ARG CODEX_VERSION=0.162.1
ENV QT_BTC_ALERTS_CODEX_CLI_VERSION=${CODEX_VERSION}
COPY --from=codex /usr/local/bin/node /usr/local/bin/node
COPY --from=codex /usr/local/lib/node_modules /usr/local/lib/node_modules
USER root
RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex
USER 10001:10001
CMD ["reviewer"]
