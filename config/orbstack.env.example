# Copy with deploy/orbstack.sh init. This example contains no working credentials.
# Local HTTP only. Do not publish this endpoint on a LAN or the internet.
QT_ORBSTACK_PORT=8877
QT_ORBSTACK_USERNAME=
# Caddy bcrypt hash, quoted so Compose preserves literal dollar signs.
QT_ORBSTACK_PASSWORD_HASH=''
# Existing Workbench origin-auth pair. Local setup generates a fresh pair.
QT_WORKBENCH_ORIGIN_CLIENT_ID=
QT_WORKBENCH_ORIGIN_CLIENT_SECRET=

# Four supported PUBLIC DATA pairs: binance/production, binance/testnet,
# okx/production, okx/demo. Selecting a demo feed never enables execution.
QT_BTC_MONITOR_VENUE=binance
QT_BTC_MONITOR_ENVIRONMENT=production

# Optional alerts. Enter a NEW bot token locally after rotating exposed tokens.
# Both must be set together. No test-account or trading key belongs in this file.
QT_TELEGRAM_BOT_TOKEN=
QT_TELEGRAM_CHAT_ID=
