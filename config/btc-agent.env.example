# Copy to an untracked file under data/runtime. Never commit credentials.
BTC_AGENT_MODE=paper
BTC_AGENT_POLL_SECONDS=300
BTC_AGENT_MAX_ORDER_QUOTE=25
BTC_AGENT_MAX_DAILY_BUY_QUOTE=25
BTC_AGENT_MAX_POSITION_QUOTE=100
# Empty model uses the installed Codex CLI default; set a supported model to pin it.
BTC_AGENT_CODEX_MODEL=
CODEX_API_KEY=
# Dedicated keys from https://testnet.binance.vision, not production keys.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
