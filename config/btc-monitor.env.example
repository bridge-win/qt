# Copy to a private, ignored .env.btc-monitor file; chmod 600.
# Compose uses this existing host path. Match the workbench API's state_root/btc-monitor.
# Relative paths are resolved from this repository's Compose project directory.
QT_BTC_MONITOR_HOST_STATE_DIR=./data/workbench/btc-monitor
# Supported pairs: binance/production, binance/testnet, okx/production, okx/demo.
# Select a DIFFERENT host state directory for every pair. Existing state refuses a different source.
QT_BTC_MONITOR_VENUE=binance
QT_BTC_MONITOR_ENVIRONMENT=production
# Set to the numeric primary group of the host workbench API user (id -g qt).
QT_BTC_MONITOR_READ_GID=10001

# Optional Telegram pair. Leave both empty for credential-free public monitoring.
# Enter values only in the private deployment env file, never in this example/source.
QT_TELEGRAM_BOT_TOKEN=
QT_TELEGRAM_CHAT_ID=

# Direct Python use only (Compose fixes the container state path at /state):
# QT_BTC_MONITOR_STATE_DIR=data/workbench/btc-monitor
# QT_BTC_MONITOR_CONFIG=/absolute/path/to/nonsecret-monitor-config.json
# A config JSON state_dir overrides the environment; --state-dir overrides both.
